#include <iostream>
#include<vector>
using namespace std;
int main(){
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int x,m;
        cin>>x>>m;
        vector<int> cnt(m+1,0);
        for(int i=0;i<x;i++){
            int t;
            cin>>t;
            cnt[t]++;
        }
        int max=0;
        for(int i=1;i<=m;i++){
            cnt[i]+=cnt[i-1];
            int cur = x-cnt[i-1];
            if(i*2<=m)
                cur+=cnt[2*i];
            if(max<cur)
                max=cur;
        }
        cout<<max<<endl;
        
    }
}
