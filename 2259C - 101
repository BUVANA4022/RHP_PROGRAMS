#include <iostream>
#include<vector>
using namespace std;
int main() {
    int u;
    cin>>u;
    for(int i=0;i<u;i++){
        int  n;
        cin>>n;
        vector<int> a(n);
        for(int i=0;i<n;i++)
            cin>>a[i];
        int l=0,r=n-1;
        while(l<n && a[l]==0)
            l++;
        while(r>=0 && a[r]==0)
            r--;
        if(l<=r){
            a[l]=a[r]=1;
            for(int j=l+1;j<r;j++){
                if(a[j]==-1)
                    a[j]=0;
            }
        }
        for(int i=0;i<n;i++)
            cout<<a[i]<<" ";
        cout<<endl;
        
    }
}
