#include <iostream>
#include<vector>
using namespace std;
int main() {
    int u;
    cin>>u;
    for(int P=0;P<u;P++){
        int n;
        cin>>n;
        vector<int> a(n);
        vector<int> z;
        string s(n,'C');
        for(int i=0;i<n;i++){
            cin>>a[i];
            if(a[i] == 0)
                z.push_back(i);
        }
        if(z.size()==1){
            cout<<"NO"<<endl;
            continue;
        }
        for(int i=0;i<z.size();i++){
            if(i==0)
                s[z[i]]='B';
            else
            s[z[i]]='A';
        }
        cout<<"YES"<<endl<<s<<endl;
        
    }
}
