#include <iostream>
#include<vector>
using namespace std;
void solve(){
    int n;
        cin>>n;
        vector<int> a(n+1);
        for(int i=1;i<=n;i++)
            cin>>a[i];
        vector<int> p(n+1,0);
        for(int i=1;i<=n;i++){
            if(a[i]==0 || a[i] == -1)
                continue;
            int t=a[i];
            if(i-t+1<0)
                p[0]++;
            else
                p[i-t+1]++;
            if(i+t<=n)
                p[i+t]-=1;
                
        }
   
        for(int i=1;i<=n;i++)
            p[i]+=p[i-1];
     
        for(int i=1;i<=n;i++){
            if(a[i]==-1)
                continue;
                if(a[i]==0 ){
                    if(p[i]!=0){
                cout<<"-1\n";
                return;
                    }
                    continue;
                }
            
            if((i-a[i]>0 && p[i-a[i]]==0) ||(i+a[i]<=n && p[i+a[i]]==0))
                continue;
            cout<<"-1\n";
            return ;
        }
        for(int i=1;i<=n;i++){
            if(p[i]>0)
                cout<<"0";
            else
                cout<<"1";
        }
        cout<<endl;
}
int main() {
    int u;
    cin>>u;
    for(int z=0;z<u;z++){
        solve();
    }
}
