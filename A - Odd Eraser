#include <iostream>
using namespace std;
int hcf(int a,int b){
    if(b == 0)
        return a;
        return hcf(b,a%b);
}
int main() {
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int m;
        cin>>m;
        int a[m];
        for(int i=0;i<m;i++)
            cin>>a[i];
        cout<<hcf(a[0],a[m-1])<<endl;
    }
    
}
